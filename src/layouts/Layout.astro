---
import '../styles/global.css';
import type { Lang } from '../lib/schemas';
import { t } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  lang: Lang;
}

const { title, description, lang } = Astro.props;
const copy = t(lang);
const homeHref = lang === 'en' ? '/en/' : '/';
const switchHref = lang === 'en' ? '/' : '/en/';
---

<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#163300" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Inter+Tight:wght@700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-white text-ink antialiased">
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-lime focus:px-4 focus:py-2 focus:text-forest">
      {lang === 'en' ? 'Skip to content' : 'Pular para o conteúdo'}
    </a>
    <header class="sticky top-0 z-40 border-b border-line/80 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3 sm:px-6">
        <a href={homeHref} class="font-title text-lg font-extrabold tracking-tight text-forest">
          mms<span class="text-lime-hover">.</span>dev
        </a>
        <nav class="flex items-center gap-2 text-sm font-medium sm:gap-3">
          <a href={`${homeHref}#projetos`} class="hidden rounded-full px-3 py-2 text-muted hover:bg-mint hover:text-forest sm:inline-flex">
            {copy.sections.projects}
          </a>
          <a href={`${homeHref}#contato`} class="hidden rounded-full px-3 py-2 text-muted hover:bg-mint hover:text-forest sm:inline-flex">
            {copy.nav.contact}
          </a>
          <a
            href={switchHref}
            class="rounded-full border-2 border-forest px-3 py-1.5 text-forest hover:bg-mint"
            aria-label={lang === 'en' ? 'Ver em português' : 'View in English'}
          >
            {copy.switchLang}
          </a>
        </nav>
      </div>
    </header>
    <main id="conteudo">
      <slot />
    </main>
    <footer class="bg-forest py-8 text-center text-sm text-mint/80">
      <p>{copy.footer.note}</p>
    </footer>
  </body>
</html>
