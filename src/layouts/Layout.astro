---
import '../styles/global.css';
import type { Lang } from '../lib/schemas';
import { t } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  lang: Lang;
}

const { title, description, lang } = Astro.props;
const copy = t(lang);
const homeHref = lang === 'en' ? '/en/' : '/';
const switchHref = lang === 'en' ? '/' : '/en/';
---

<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Ubuntu+Mono:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-zinc-950 text-zinc-100 antialiased">
    <header class="border-b border-zinc-800/80 bg-zinc-950/90 backdrop-blur">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
        <a href={homeHref} class="font-title text-sm font-bold tracking-tight text-white">
          mms.dev
        </a>
        <nav class="flex items-center gap-4 text-sm text-zinc-400">
          <a href={homeHref} class="hover:text-white">{copy.nav.home}</a>
          <a href={switchHref} class="rounded border border-zinc-700 px-2 py-1 hover:border-zinc-500 hover:text-white">
            {copy.switchLang}
          </a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="border-t border-zinc-800/80 py-8 text-center text-sm text-zinc-500">
      <p>{copy.footer.note}</p>
    </footer>
  </body>
</html>
