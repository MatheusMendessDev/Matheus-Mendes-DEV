---
import Layout from '../layouts/Layout.astro';
import HeroBackground from './HeroBackground.astro';
import ServiceIcon from './ServiceIcon.astro';
import { getResume, getServices, getUiStack } from '../lib/content';
import { t } from '../lib/i18n';
import type { Lang } from '../lib/schemas';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang);
const resume = getResume(lang);
const services = getServices();
const stackGroups = resume.stackGroups;
const uiStack = getUiStack();
const alsoWorksWith = resume.alsoWorksWith ?? [];
---

<Layout
  title={`${resume.name} — ${resume.title}`}
  description={resume.summaryMachine}
  lang={lang}
>
  <section class="hero-section relative overflow-hidden border-b border-zinc-800/40">
    <HeroBackground />
    <div class="relative z-10 mx-auto max-w-5xl px-6 py-20 md:py-28">
      <div class="max-w-3xl" data-reveal>
      <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">
        {resume.name}
      </h1>
      <p class="font-title mt-4 text-xl text-zinc-200 md:text-2xl">{resume.title}</p>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-zinc-300 md:text-lg">{resume.summaryHuman}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={resume.links.email.startsWith('mailto:') ? resume.links.email : `mailto:${resume.links.email}`}
          class="rounded-lg bg-emerald-500 px-5 py-2.5 text-sm font-medium text-zinc-950 hover:bg-emerald-400"
        >
          {copy.hero.cta}
        </a>
        <a
          href={resume.links.whatsapp}
          target="_blank"
          rel="noreferrer"
          class="rounded-lg border border-zinc-700 px-5 py-2.5 text-sm font-medium text-zinc-200 hover:border-zinc-500"
        >
          WhatsApp
        </a>
      </div>
      </div>
    </div>
  </section>

  <section class="border-t border-zinc-800/80 bg-zinc-900/30">
    <div class="mx-auto max-w-5xl px-6 py-14" data-reveal>
      <h2 class="text-2xl font-semibold text-white">{copy.sections.howIWorkWithAi}</h2>
      <ul class="mt-6 space-y-3">
        {
          resume.howIWorkWithAi.map((item) => (
            <li class="flex gap-3 text-sm leading-relaxed text-zinc-300">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-400" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-14" data-services-carousel data-reveal>
    <div class="flex items-end justify-between gap-6">
      <div>
        <p class="font-title text-xs font-medium uppercase tracking-[0.2em] text-emerald-400">
          {lang === 'en' ? 'What I solve' : 'O que eu resolvo'}
        </p>
        <h2 class="mt-2 text-2xl font-semibold text-white">{copy.sections.services}</h2>
      </div>
      <div class="flex gap-2">
        <button
          type="button"
          data-carousel-prev
          aria-label={lang === 'en' ? 'Previous service' : 'Serviço anterior'}
          class="carousel-control"
        >
          <span aria-hidden="true">←</span>
        </button>
        <button
          type="button"
          data-carousel-next
          aria-label={lang === 'en' ? 'Next service' : 'Próximo serviço'}
          class="carousel-control"
        >
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>

    <div
      class="services-track mt-8"
      data-carousel-track
      aria-label={lang === 'en' ? 'Services' : 'Serviços'}
      tabindex="0"
    >
      {
        services.map((service, index) => (
          <article
            class="service-card group rounded-xl border border-zinc-800 bg-zinc-900/50 p-6 transition-colors hover:border-emerald-500/40"
            data-carousel-slide
            aria-label={`${index + 1} / ${services.length}`}
          >
            <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-emerald-500/20 bg-emerald-500/10 text-emerald-400 transition-transform duration-300 group-hover:-translate-y-1">
              <ServiceIcon service={service.id} />
            </div>
            <h3 class="mt-6 text-lg font-medium text-white">
              {lang === 'en' ? service.name.en : service.name.pt}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-zinc-300">
              {lang === 'en' ? service.pitch.en : service.pitch.pt}
            </p>
            <p class="mt-4 text-sm leading-relaxed text-zinc-500">
              {lang === 'en' ? service.deliverable.en : service.deliverable.pt}
            </p>
          </article>
        ))
      }
    </div>
    <p class="mt-4 text-xs text-zinc-600 sm:hidden">
      {lang === 'en' ? 'Swipe to explore' : 'Deslize para explorar'}
    </p>
  </section>

  <section class="border-t border-zinc-800/80 bg-zinc-900/30">
    <div class="mx-auto max-w-5xl px-6 py-14" data-reveal>
      <h2 class="text-2xl font-semibold text-white">{copy.sections.skills}</h2>
      {
        stackGroups ? (
          <div class="mt-6 grid gap-6 sm:grid-cols-3">
            <div>
              <h3 class="text-sm font-medium uppercase tracking-wide text-zinc-400">
                {uiStack.wordpress.label[lang]}
              </h3>
              <ul class="mt-3 flex flex-wrap gap-2">
                {
                  stackGroups.wordpress.map((skill) => (
                    <li class="rounded-full border border-zinc-800 bg-zinc-900 px-3 py-1 text-sm text-zinc-300">
                      {skill}
                    </li>
                  ))
                }
              </ul>
            </div>
            <div>
              <h3 class="text-sm font-medium uppercase tracking-wide text-zinc-400">
                {uiStack.code.label[lang]}
              </h3>
              <ul class="mt-3 flex flex-wrap gap-2">
                {
                  stackGroups.code.map((skill) => (
                    <li class="rounded-full border border-zinc-800 bg-zinc-900 px-3 py-1 text-sm text-zinc-300">
                      {skill}
                    </li>
                  ))
                }
              </ul>
            </div>
            <div>
              <h3 class="text-sm font-medium uppercase tracking-wide text-zinc-400">
                {uiStack.workflow.label[lang]}
              </h3>
              <ul class="mt-3 flex flex-wrap gap-2">
                {
                  stackGroups.workflow.map((skill) => (
                    <li class="rounded-full border border-zinc-800 bg-zinc-900 px-3 py-1 text-sm text-zinc-300">
                      {skill}
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        ) : (
          <ul class="mt-6 flex flex-wrap gap-2">
            {
              resume.skills.map((skill) => (
                <li class="rounded-full border border-zinc-800 bg-zinc-900 px-3 py-1 text-sm text-zinc-300">
                  {skill}
                </li>
              ))
            }
          </ul>
        )
      }
      {
        alsoWorksWith.length > 0 && (
          <div class="mt-8">
            <h3 class="text-sm font-medium text-zinc-500">{copy.alsoWorksWith}</h3>
            <ul class="mt-3 flex flex-wrap gap-2">
              {
                alsoWorksWith.map((skill) => (
                  <li class="rounded-full border border-zinc-800/60 bg-zinc-900/40 px-3 py-1 text-xs text-zinc-500">
                    {skill}
                  </li>
                ))
              }
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-14" data-reveal>
    <h2 class="text-2xl font-semibold text-white">{copy.sections.projects}</h2>
    <div class="mt-8 grid gap-4">
      {
        resume.projects.map((project) => (
          <article class="rounded-xl border border-zinc-800 p-5">
            <h3 class="font-medium text-white">{project.name}</h3>
            <p class="mt-2 text-sm text-zinc-400">{project.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="border-t border-zinc-800/80 bg-zinc-900/30">
    <div class="mx-auto max-w-5xl px-6 py-14" data-reveal>
      <h2 class="text-2xl font-semibold text-white">{copy.sections.contact}</h2>
      <ul class="mt-6 space-y-2 text-zinc-300">
        <li>
          Email:
          <a href={`mailto:${resume.links.email}`} class="ml-2 text-emerald-400 hover:underline">
            {resume.links.email}
          </a>
        </li>
        <li>
          WhatsApp:
          <a href={resume.links.whatsapp} class="ml-2 text-emerald-400 hover:underline" target="_blank" rel="noreferrer">
            +55 11 97761-7473
          </a>
        </li>
        <li>
          LinkedIn:
          <a href={resume.links.linkedin} class="ml-2 text-emerald-400 hover:underline" target="_blank" rel="noreferrer">
            {resume.links.linkedin}
          </a>
        </li>
        <li>
          GitHub:
          <a href={resume.links.github} class="ml-2 text-emerald-400 hover:underline" target="_blank" rel="noreferrer">
            {resume.links.github}
          </a>
        </li>
      </ul>
    </div>
  </section>
</Layout>

<script>
  function initRevealAnimations() {
    const elements = document.querySelectorAll<HTMLElement>('[data-reveal]');
    if (!elements.length) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      elements.forEach((element) => element.classList.add('is-visible'));
      return;
    }

    document.documentElement.classList.add('reveal-enabled');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -48px' },
    );

    elements.forEach((element) => observer.observe(element));
  }

  function initServicesCarousel() {
    document.querySelectorAll<HTMLElement>('[data-services-carousel]').forEach((carousel) => {
      const track = carousel.querySelector<HTMLElement>('[data-carousel-track]');
      const previous = carousel.querySelector<HTMLButtonElement>('[data-carousel-prev]');
      const next = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
      if (!track || !previous || !next) return;

      const scrollByCard = (direction: number) => {
        const slides = track.querySelectorAll<HTMLElement>('[data-carousel-slide]');
        const distance =
          slides.length > 1
            ? slides[1].offsetLeft - slides[0].offsetLeft
            : track.clientWidth;
        track.scrollBy({ left: distance * direction, behavior: 'smooth' });
      };

      const updateControls = () => {
        const maxScroll = track.scrollWidth - track.clientWidth;
        previous.disabled = track.scrollLeft <= 2;
        next.disabled = track.scrollLeft >= maxScroll - 2;
      };

      previous.addEventListener('click', () => scrollByCard(-1));
      next.addEventListener('click', () => scrollByCard(1));
      track.addEventListener('scroll', updateControls, { passive: true });
      window.addEventListener('resize', updateControls);
      updateControls();
    });
  }

  initRevealAnimations();
  initServicesCarousel();
</script>

<style>
  :global(.reveal-enabled [data-reveal]) {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 420ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(.reveal-enabled [data-reveal].is-visible) {
    opacity: 1;
    transform: translateY(0);
  }

  .services-track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .services-track::-webkit-scrollbar {
    display: none;
  }

  .service-card {
    flex: 0 0 min(86vw, 22rem);
    min-height: 20rem;
    scroll-snap-align: start;
  }

  .carousel-control {
    display: grid;
    height: 2.5rem;
    width: 2.5rem;
    place-items: center;
    border: 1px solid rgb(63 63 70);
    border-radius: 9999px;
    color: rgb(228 228 231);
    transition:
      border-color 200ms ease,
      color 200ms ease,
      opacity 200ms ease;
  }

  .carousel-control:hover:not(:disabled) {
    border-color: rgb(52 211 153);
    color: rgb(52 211 153);
  }

  .carousel-control:disabled {
    cursor: not-allowed;
    opacity: 0.3;
  }

  @media (min-width: 640px) {
    .service-card {
      flex-basis: calc((100% - 1rem) / 2);
    }
  }

  @media (min-width: 1024px) {
    .service-card {
      flex-basis: calc((100% - 2rem) / 3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-reveal]) {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }

    .services-track {
      scroll-behavior: auto;
    }
  }
</style>
