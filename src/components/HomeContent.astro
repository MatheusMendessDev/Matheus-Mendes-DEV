---
import Layout from '../layouts/Layout.astro';
import Avatar from './Avatar.astro';
import ServiceIcon from './ServiceIcon.astro';
import { getResume, getServices, getUiStack } from '../lib/content';
import { t } from '../lib/i18n';
import type { Lang } from '../lib/schemas';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang);
const resume = getResume(lang);
const services = getServices();
const stackGroups = resume.stackGroups;
const uiStack = getUiStack();
const alsoWorksWith = resume.alsoWorksWith ?? [];

const email = resume.links.email.replace(/^mailto:/, '');
// Rótulos curtos no lugar das URLs inteiras: legíveis e sem estourar a largura no celular.
const contacts = [
  { label: 'Email', value: email, href: `mailto:${email}`, external: false },
  { label: 'WhatsApp', value: '+55 11 97761-7473', href: resume.links.whatsapp, external: true },
  { label: 'LinkedIn', value: resume.links.linkedin.replace(/^https?:\/\/(www\.)?linkedin\.com/, '').replace(/\/$/, ''), href: resume.links.linkedin, external: true },
  { label: 'GitHub', value: '@' + resume.links.github.replace(/^https?:\/\/(www\.)?github\.com\//, '').replace(/\/$/, ''), href: resume.links.github, external: true },
];
---

<Layout
  title={`${resume.name} — ${resume.title}`}
  description={resume.summaryMachine}
  lang={lang}
>
  <section class="on-dark relative overflow-hidden bg-forest text-white">
    <div class="relative z-10 mx-auto grid max-w-6xl items-center gap-10 px-5 py-16 sm:px-6 md:py-24 lg:grid-cols-[1fr_auto] lg:gap-16">
      <div class="flex justify-center lg:order-2" data-reveal>
        <Avatar lang={lang} name={resume.name} />
      </div>
      <div class="max-w-2xl lg:order-1" data-reveal>
        {
          resume.availability.available && (
            <p class="chip bg-white/10 text-mint">
              <span class="mr-2 h-2 w-2 rounded-full bg-lime" aria-hidden="true" />
              {resume.availability.status}
            </p>
          )
        }
        <h1 class="mt-6 text-5xl font-extrabold leading-[0.95] text-white sm:text-6xl lg:text-7xl">
          {resume.name}
        </h1>
        <p class="font-title mt-5 text-2xl font-bold text-lime md:text-3xl">{resume.title}</p>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-mint/90 md:text-lg">{resume.summaryHuman}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={`mailto:${email}`} class="btn btn-primary">
            {copy.hero.cta}
            <span aria-hidden="true">→</span>
          </a>
          <a href={resume.links.whatsapp} target="_blank" rel="noreferrer" class="btn btn-outline-light">
            WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-surface">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-6 md:py-20" data-reveal>
      <h2 class="max-w-2xl text-3xl font-extrabold text-forest md:text-4xl">{copy.sections.howIWorkWithAi}</h2>
      <ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          resume.howIWorkWithAi.map((item, i) => (
            <li class="rounded-3xl bg-white p-6">
              <span class="font-title flex h-10 w-10 items-center justify-center rounded-full bg-lime text-lg font-extrabold text-forest">
                {i + 1}
              </span>
              <p class="mt-4 leading-relaxed text-muted">{item}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-6 md:py-20" data-services-carousel data-reveal>
    <div class="flex items-end justify-between gap-6">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.15em] text-forest-soft">
          {lang === 'en' ? 'What I solve' : 'O que eu resolvo'}
        </p>
        <h2 class="mt-2 text-3xl font-extrabold text-forest md:text-4xl">{copy.sections.services}</h2>
      </div>
      <div class="flex shrink-0 gap-2">
        <button
          type="button"
          data-carousel-prev
          aria-label={lang === 'en' ? 'Previous service' : 'Serviço anterior'}
          class="carousel-control"
        >
          <span aria-hidden="true">←</span>
        </button>
        <button
          type="button"
          data-carousel-next
          aria-label={lang === 'en' ? 'Next service' : 'Próximo serviço'}
          class="carousel-control"
        >
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>

    <div
      class="services-track mt-8"
      data-carousel-track
      aria-label={lang === 'en' ? 'Services' : 'Serviços'}
      tabindex="0"
    >
      {
        services.map((service, index) => (
          <article
            class="service-card group rounded-3xl border border-line bg-white p-7 transition-colors hover:border-forest/40 hover:bg-surface"
            data-carousel-slide
            aria-label={`${index + 1} / ${services.length}`}
          >
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-mint text-forest transition-transform duration-300 group-hover:-translate-y-1">
              <ServiceIcon service={service.id} />
            </div>
            <h3 class="mt-6 text-2xl font-bold text-forest">
              {lang === 'en' ? service.name.en : service.name.pt}
            </h3>
            <p class="mt-3 font-medium leading-relaxed text-ink">
              {lang === 'en' ? service.pitch.en : service.pitch.pt}
            </p>
            <p class="mt-4 text-sm leading-relaxed text-muted">
              {lang === 'en' ? service.deliverable.en : service.deliverable.pt}
            </p>
          </article>
        ))
      }
    </div>
    <p class="mt-4 text-xs text-subtle sm:hidden">
      {lang === 'en' ? 'Swipe to explore' : 'Deslize para explorar'}
    </p>
  </section>

  <section id="projetos" class="scroll-mt-20 bg-surface">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-6 md:py-20" data-reveal>
      <p class="text-sm font-semibold uppercase tracking-[0.15em] text-forest-soft">{copy.projects.eyebrow}</p>
      <h2 class="mt-2 text-3xl font-extrabold text-forest md:text-4xl">{copy.sections.projects}</h2>
      <p class="mt-4 max-w-2xl leading-relaxed text-muted">{copy.projects.intro}</p>

      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {
          resume.projects.map((project, i) => (
            <article class="flex flex-col rounded-3xl bg-white p-7">
              <div class="flex items-start justify-between gap-3">
                <span class="font-title text-5xl font-extrabold leading-none text-mint-strong" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="chip bg-surface text-xs text-subtle">
                  <svg viewBox="0 0 24 24" class="mr-1.5 h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="5" y="11" width="14" height="10" rx="2" />
                    <path d="M8 11V8a4 4 0 0 1 8 0v3" />
                  </svg>
                  {copy.projects.confidential}
                </span>
              </div>
              {project.segment && <p class="mt-6 text-sm font-semibold text-forest-soft">{project.segment}</p>}
              <h3 class="mt-1 text-xl font-bold leading-snug text-forest">{project.name}</h3>
              <p class="mt-3 leading-relaxed text-muted">{project.description}</p>
              {
                project.highlights.length > 0 && (
                  <ul class="mt-5 space-y-2">
                    {project.highlights.map((h) => (
                      <li class="flex gap-2.5 text-sm leading-relaxed text-ink">
                        <svg viewBox="0 0 24 24" class="mt-0.5 h-4 w-4 shrink-0 text-forest" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M5 12.5l4.5 4.5L19 7.5" />
                        </svg>
                        {h}
                      </li>
                    ))}
                  </ul>
                )
              }
              {
                project.tags.length > 0 && (
                  <ul class="mt-auto flex flex-wrap gap-2 pt-6" aria-label={lang === 'en' ? 'Technologies' : 'Tecnologias'}>
                    {project.tags.map((tag) => (
                      <li class="chip bg-mint text-forest">{tag}</li>
                    ))}
                  </ul>
                )
              }
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-6 md:py-20" data-reveal>
    <h2 class="text-3xl font-extrabold text-forest md:text-4xl">{copy.sections.skills}</h2>
    {
      stackGroups ? (
        <div class="mt-8 grid gap-8 sm:grid-cols-3">
          {(['code', 'wordpress', 'workflow'] as const).map((group) => (
            <div>
              <h3 class="text-sm font-semibold uppercase tracking-wide text-subtle">{uiStack[group].label[lang]}</h3>
              <ul class="mt-3 flex flex-wrap gap-2">
                {stackGroups[group].map((skill) => (
                  <li class="chip border border-line bg-white text-ink">{skill}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      ) : (
        <ul class="mt-8 flex flex-wrap gap-2">
          {resume.skills.map((skill) => (
            <li class="chip border border-line bg-white text-ink">{skill}</li>
          ))}
        </ul>
      )
    }
    {
      alsoWorksWith.length > 0 && (
        <div class="mt-10">
          <h3 class="text-sm font-semibold text-subtle">{copy.alsoWorksWith}</h3>
          <ul class="mt-3 flex flex-wrap gap-2">
            {alsoWorksWith.map((skill) => (
              <li class="chip bg-surface text-xs text-muted">{skill}</li>
            ))}
          </ul>
        </div>
      )
    }
  </section>

  <section id="contato" class="on-dark scroll-mt-20 bg-forest text-white">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-6 md:py-24" data-reveal>
      <div class="grid gap-10 lg:grid-cols-2 lg:items-center [&>*]:min-w-0">
        <div>
          <h2 class="text-4xl font-extrabold leading-tight text-white md:text-5xl">{copy.contact.title}</h2>
          <p class="mt-4 text-lg text-mint/90">{copy.contact.text}</p>
          <a href={`mailto:${email}`} class="btn btn-primary mt-8">
            {copy.hero.cta}
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <ul class="grid gap-3">
          {
            contacts.map((c) => (
              <li>
                <a
                  href={c.href}
                  {...(c.external ? { target: '_blank', rel: 'noreferrer' } : {})}
                  class="flex items-center justify-between gap-4 rounded-2xl bg-white/5 px-5 py-4 transition-colors hover:bg-white/10"
                >
                  <span class="min-w-0">
                    <span class="block text-xs font-semibold uppercase tracking-wide text-lime">{c.label}</span>
                    <span class="mt-0.5 block text-white [overflow-wrap:anywhere]">
                      {/* Se não couber, o e-mail quebra depois do "@" e não no meio do domínio. */}
                      {c.value.includes('@') && !c.value.startsWith('@') ? (
                        <>{c.value.split('@')[0]}@<wbr />{c.value.split('@')[1]}</>
                      ) : (
                        c.value
                      )}
                    </span>
                  </span>
                  <span class="shrink-0 text-lime" aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Layout>

<script>
  function initRevealAnimations() {
    const elements = document.querySelectorAll<HTMLElement>('[data-reveal]');
    if (!elements.length) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      elements.forEach((element) => element.classList.add('is-visible'));
      return;
    }

    document.documentElement.classList.add('reveal-enabled');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -48px' },
    );

    elements.forEach((element) => observer.observe(element));
  }

  function initServicesCarousel() {
    document.querySelectorAll<HTMLElement>('[data-services-carousel]').forEach((carousel) => {
      const track = carousel.querySelector<HTMLElement>('[data-carousel-track]');
      const previous = carousel.querySelector<HTMLButtonElement>('[data-carousel-prev]');
      const next = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
      if (!track || !previous || !next) return;

      const scrollByCard = (direction: number) => {
        const slides = track.querySelectorAll<HTMLElement>('[data-carousel-slide]');
        const distance =
          slides.length > 1
            ? slides[1].offsetLeft - slides[0].offsetLeft
            : track.clientWidth;
        track.scrollBy({ left: distance * direction, behavior: 'smooth' });
      };

      const updateControls = () => {
        const maxScroll = track.scrollWidth - track.clientWidth;
        previous.disabled = track.scrollLeft <= 2;
        next.disabled = track.scrollLeft >= maxScroll - 2;
      };

      previous.addEventListener('click', () => scrollByCard(-1));
      next.addEventListener('click', () => scrollByCard(1));
      track.addEventListener('scroll', updateControls, { passive: true });
      window.addEventListener('resize', updateControls);
      updateControls();
    });
  }

  initRevealAnimations();
  initServicesCarousel();
</script>

<style>
  :global(.reveal-enabled [data-reveal]) {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 420ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(.reveal-enabled [data-reveal].is-visible) {
    opacity: 1;
    transform: translateY(0);
  }

  .services-track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .services-track::-webkit-scrollbar {
    display: none;
  }

  .service-card {
    /* Largura relativa ao carrossel (não à tela): não estoura no celular. */
    flex: 0 0 min(86%, 22rem);
    min-height: 20rem;
    scroll-snap-align: start;
  }

  .carousel-control {
    display: grid;
    height: 2.75rem;
    width: 2.75rem;
    place-items: center;
    border: 2px solid var(--color-forest);
    border-radius: 9999px;
    color: var(--color-forest);
    font-weight: 600;
    transition:
      background-color 150ms ease,
      opacity 150ms ease;
  }

  .carousel-control:hover:not(:disabled) {
    background: var(--color-mint);
  }

  .carousel-control:disabled {
    cursor: not-allowed;
    opacity: 0.3;
  }

  @media (min-width: 640px) {
    .service-card {
      flex-basis: calc((100% - 1rem) / 2);
    }
  }

  @media (min-width: 1024px) {
    .service-card {
      flex-basis: calc((100% - 2rem) / 3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-reveal]) {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }

    .services-track {
      scroll-behavior: auto;
    }
  }
</style>
