---
interface Props {
  service: string;
}

const { service } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class="h-7 w-7"
>
  {
    service === 'site-wordpress' && (
      <>
        <rect x="3" y="4" width="18" height="16" rx="2" />
        <path d="M3 8h18" />
        <path d="m10 12-2.5 2.5L10 17M14 12l2.5 2.5L14 17" />
      </>
    )
  }
  {
    service === 'loja-woocommerce' && (
      <>
        <path d="M3.5 5.5h17l-1.5 9h-13z" />
        <path d="M8 9.5v1.8a2 2 0 0 0 4 0V9.5a2 2 0 0 0 4 0v1.8" />
        <circle cx="8" cy="18.5" r="1" />
        <circle cx="17" cy="18.5" r="1" />
      </>
    )
  }
  {
    service === 'redesign-figma' && (
      <>
        <rect x="4" y="3" width="16" height="18" rx="2" />
        <path d="M8 8h8M8 12h5M8 16h8" />
        <path d="m15 11 3 3-3 3" />
      </>
    )
  }
  {
    service === 'conserto-performance' && (
      <>
        <path d="M4 17a8 8 0 1 1 16 0" />
        <path d="m12 15 4-5" />
        <circle cx="12" cy="17" r="1" />
        <path d="M5.5 13H8M16 13h2.5M12 7v2" />
      </>
    )
  }
  {
    service === 'manutencao-mensal' && (
      <>
        <path d="M14.5 6.5a4 4 0 0 0-5 5L4 17l3 3 5.5-5.5a4 4 0 0 0 5-5l-2.3 2.3-3-3z" />
        <path d="m5.5 17.5 1 1" />
      </>
    )
  }
</svg>
